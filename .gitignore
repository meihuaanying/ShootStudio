# 凭据与本地数据（禁止提交）
app/assets/config/image_sources.json

# 构建产物
app/build/
web/dist/
web/.astro/
**/node_modules/
app/.dart_tool/
app/tool/engine_build/node_modules/
app/tool/engine_build/.gen/

# 运行期数据（如误落在仓库内）
**/logs/
**/exports/
**/*.sqlite
**/*.sqlite-journal

# 平台工程生成物
app/windows/flutter/ephemeral/
app/android/.gradle/
app/android/.kotlin/
app/android/local.properties
app/android/key.properties
app/*.keystore
app/*.jks

# 编辑器与系统
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Python 工具缓存
__pycache__/
*.pyc

# E 阶段抓取图池：图片不入 git（R47）
app/tool/gear_photo_pool/

# V7 开放索引构建缓存（CSV 原始数据不入 git）
app/tool/open_index_cache/

# V8 golden 失败差分图（临时产物，不入仓）
app/test/**/failures/

# GraphFlow 本地知识图谱缓存（sqlite/wal/shm 是运行时状态，不是源码）
.graphflow-cache/
graphflow-out/

# V8/P2 引擎性能门禁的 CI 侧实测产物：每次 run 重算、数值随机器抖，
# 不进 git。参照基线仍入库（docs/qa/v8-s2-engine-perf-swiftshader-dpr1.json）。
docs/qa/v8-s2-engine-perf-ci-gate.json
