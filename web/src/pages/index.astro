---
import Layout from '../layouts/Layout.astro';
import { steps, cards } from '../data/landing';

const version = import.meta.env.PUBLIC_APP_VERSION?.replace(/^v/, '') || '2.0.0';
---

<Layout title="正片工坊 ShootStudio · 画面参考到一键成案">
  <!-- 首屏：真实产品静帧（D157 ≥50% 视口宽）+ 衬线大标题 + 双下载 CTA -->
  <section class="border-b border-v8-rule" data-hero>
    <div
      class="mx-auto grid max-w-[1280px] items-center gap-8 px-6 py-14 lg:grid-cols-[minmax(0,0.92fr)_minmax(0,1.08fr)] lg:gap-12 lg:py-20"
    >
      <div>
        <p class="eyebrow" data-hero-item>SHOOTSTUDIO · V{version} · MIT 开源</p>
        <h1
          class="mt-4 font-display text-[34px] font-semibold leading-[1.2] tracking-tight md:text-[40px]"
          data-hero-item
        >
          两分钟灵感，<br />三十分钟成案
        </h1>
        <p class="mt-4 max-w-xl text-[14px] leading-6 text-v8-ink-soft" data-hero-item>
          画面参考 → 布光预演 → 动作摆姿 → 一键成案。本地优先的免费开源摄影策划工作台，
          Windows 与 Android 同一份代码，数据全部留在你自己的机器上。
        </p>
        <div class="mt-6 flex flex-wrap gap-3" data-hero-item>
          <a class="btn-primary" href="/downloads">Windows 下载 v{version}</a>
          <a class="btn-ghost" href="/downloads">安卓 APK 下载 v{version}</a>
        </div>
        <p class="mono mt-4 text-v8-muted" data-hero-item>
          国内 CDN 镜像优先 · GitHub Release 回退 · SHA-256 校验
        </p>
      </div>
      <!-- D157：首屏必须用真实产品截图，不用装饰性 SVG -->
      <figure class="shot" data-hero-item data-hero-visual>
        <picture>
          <source srcset="/shots/hero-dark.png" media="(prefers-color-scheme: dark)" />
          <img
            src="/shots/hero-paper.png"
            alt="成案阅读视图：衬线刊头、读数预算表与模块图卡"
            width="1920"
            height="1080"
            loading="eager"
            decoding="async"
          />
        </picture>
        <figcaption class="mono mt-2 text-v8-muted">
          成案阅读视图 · 真实产品静帧（明暗双主题各一张）
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- 四步工作流 -->
  <section class="mx-auto max-w-[1280px] px-6 py-16" data-reveal>
    <p class="eyebrow">工作流</p>
    <h2 class="mt-2 font-display text-[22px] font-semibold">视频里的四步，这里一步不缺</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-4">
      {
        steps.map((step) => (
          <article class="card p-5">
            <p class="eyebrow">STEP {step.no}</p>
            <h3 class="mt-2 text-[17px] font-semibold">{step.title}</h3>
            <p class="mono mt-1 text-v8-muted">{step.tool}</p>
            <p class="mt-2 text-[13px] leading-6 text-v8-ink-soft">{step.desc}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- 能力总览（图片主导：每项配真实截图） -->
  <section class="border-y border-v8-rule bg-v8-surface" data-reveal>
    <div class="mx-auto max-w-[1280px] px-6 py-16">
      <p class="eyebrow">能力</p>
      <h2 class="mt-2 font-display text-[22px] font-semibold">
        八大能力，围绕成案闭环
      </h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          cards.map((card) => (
            <article class="card overflow-hidden p-0">
              <img
                class="block w-full"
                src={`/shots/${card.shot}.png`}
                alt={card.title}
                width="1920"
                height="1080"
                loading="lazy"
                decoding="async"
              />
              <div class="p-5">
                <h3 class="text-[17px] font-semibold">{card.title}</h3>
                <p class="mt-2 text-[13px] leading-6 text-v8-ink-soft">{card.desc}</p>
              </div>
            </article>
          ))
        }
      </div>
      <a class="btn-ghost mt-8" href="/features">查看完整功能说明 →</a>
    </div>
  </section>

  <!-- 本地优先 -->
  <section class="mx-auto max-w-[1280px] px-6 py-16" data-reveal>
    <div class="card flex flex-col items-start gap-6 p-8 md:flex-row md:items-center">
      <div class="max-w-xl">
        <p class="eyebrow">本地优先</p>
        <h2 class="mt-2 font-display text-[22px] font-semibold">数据不出本机</h2>
        <p class="mt-3 text-[14px] leading-6 text-v8-ink-soft">
          工作区就是一个普通文件夹：数据库、素材与导出产物都在你自己的磁盘上。
          不上传、不注册、不订阅；AI 通道不配置 Key 时自动回退到本地规则引擎。
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a class="btn-primary" href="/downloads">去下载</a>
          <a class="btn-ghost" href="/templates">先看模板库</a>
        </div>
      </div>
      <pre class="mono w-full max-w-sm overflow-x-auto rounded-v8-control border border-v8-rule bg-v8-sunken p-4 text-v8-ink-soft">工作区/
├── database.sqlite
├── images/（五库 + 参考 + 素材）
└── exports/（长图 / PDF / .sspak）</pre>
    </div>
  </section>
</Layout>
