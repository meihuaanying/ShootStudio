---
import Layout from '../layouts/Layout.astro';

/**
 * V8/S10 · D157：每个功能 = 真实截图 + 眉题 + 短文案的杂志跨页式布局。
 * `shot` 指向 web/public/shots/<shot>.png（真实产品静帧，禁止占位图 R82）。
 */
const modules = [
  {
    no: '6.1',
    title: '画面参考库',
    tool: 'FILMGRAB 转化',
    shot: 'refs',
    alt: '画面参考搜索结果：大图瀑布流 + 分类眉题',
    points: [
      '13 路来源与 NetRouter 检索管线不动（R75），只改展示与排序层。',
      '结果保留原图纵横比；悬停显来源、许可、收画板、以图搜图。',
      '画板是画册式编排页：图卡网格 + 拖拽排序 + 导出长图。',
    ],
  },
  {
    no: '6.2',
    title: '布光预演室',
    tool: 'Set.a.light 转化',
    shot: 'lighting',
    alt: '布光预演三栏工作区：左清单 / 中画布 / 右检查器',
    points: [
      '左清单 / 中央画布 / 右检查器三栏，灯位拖拽即见即所得。',
      '灯位方案可保存复用，并绑定到策划案的布光模块。',
      '撤销与重做按操作语义合并，误操作可退。',
    ],
  },
  {
    no: '6.3',
    title: '动作摆姿库',
    tool: 'posemaniacs 转化',
    shot: 'poses',
    alt: '动作摆姿库：大图瀑布流 + 分类眉题',
    points: [
      '10 类 120 条姿势，大图瀑布流 + 分类眉题，详情走半屏抽屉。',
      '识别链路收口四步：导入 → 识别中 → 校正 → 送入布光。',
      '关节点可拖拽微调，实时重算 12 组关节读数，支持单关节与全部复位。',
    ],
  },
  {
    no: '6.4',
    title: '工作区与五大资源库',
    tool: '本地优先',
    shot: 'library',
    alt: '资源库页：模特 / 服装 / 道具 / 场景 / 器材',
    points: [
      '模特、服装、道具、场景、器材五大资源库，字段结构一致。',
      '设备库（相机 / 镜头 / 灯光 / 配件 / 服装 / 道具）覆盖率六类 100%。',
      '所有资源就存在工作区目录里，删除计划不会带走原图。',
    ],
  },
  {
    no: '6.5',
    title: '积木式策划编辑器与模板库',
    tool: '积木式',
    shot: 'plan',
    alt: '策划案阅读视图：衬线刊头 + 读数预算表',
    points: [
      '模块化画布：主题、日落、样片、色板、布光、姿势、分镜、分工、预算。',
      '模板库按 Cos 正片等场景预置模块组，插入后可逐块改。',
      '阅读视图按杂志内页排版：Display 衬线刊头 + 眉题分节 + 图卡分镜。',
    ],
  },
  {
    no: '6.6',
    title: 'AI 策划助手',
    tool: '可离线降级',
    shot: 'ai',
    alt: 'AI 面板生成中：流式输出 + 尝试链 + 取消',
    points: [
      '三态收敛：描述 → 生成中（流式、可取消）→ 阅读成案。',
      '生成失败自动换商（同商换模型 → 换商），尝试链逐条可见。',
      '被取消的草稿只是占位，三处都不可写入画布；不配 Key 时走本地规则引擎。',
    ],
  },
  {
    no: '6.7',
    title: '导出与分享',
    tool: '长图 / PDF / .sspak',
    shot: 'export',
    alt: '导出面板：三种格式与完整性校验',
    points: [
      '长图 / PDF / .sspak 三格式，导出前做完整性校验。',
      '长图与 PDF 都带页眉、页脚与来源 / 许可附录页，空来源显式写「未标注来源」。',
      '.sspak 走 v2 版式；旧包导入时明示迁移，更高版本明确要求先升级。',
    ],
  },
  {
    no: '6.8',
    title: '官网与下载中心',
    tool: '双通道',
    shot: 'update',
    alt: '应用内更新横幅：公告通道与版本提示',
    points: [
      '官网与 App 同源设计令牌，明暗双主题、栅格与字号逐字一致。',
      '下载页提供镜像与 GitHub Release 双通道，附 SHA-256 校验值。',
      '公告走 announcements.json 通道：可自建站点 / 内网，空值回落官方默认。',
    ],
  },
  {
    no: '6.9',
    title: '应用内更新与推送',
    tool: '公告通道',
    shot: 'settings',
    alt: '设置页：公告地址、AI 通道、素材源与显卡后端',
    points: [
      '设置页可自定义公告 JSON 地址，支持自建站点与内网。',
      'AI 通道、素材源、渲染后端都在同一页内可改可回滚。',
      '设置往返即时生效，调试构建下还能打开设计组件预览。',
    ],
  },
];
---

<Layout
  title="功能 · 正片工坊 ShootStudio"
  description="九个功能模块，从画面参考到一键成案：画面参考库、布光预演室、动作摆姿库、资源库、策划编辑器、AI 助手、导出与分享、下载中心、应用内更新。"
>
  <section class="mx-auto max-w-[1280px] px-6 pb-10 pt-14">
    <p class="eyebrow">功能</p>
    <h1 class="mt-3 font-display text-[28px] font-semibold md:text-[40px]">
      九个功能模块，一条闭环
    </h1>
    <p class="mt-4 max-w-2xl text-[14px] leading-6 text-v8-ink-soft">
      每一项都配真实产品静帧：左边是应用里的实际界面，右边写它到底解决什么问题。
      没有示意图，也没有占位图。
    </p>
  </section>

  <div class="mx-auto flex max-w-[1280px] flex-col gap-6 px-6 pb-20">
    {
      modules.map((m, index) => (
        <article
          class="card grid overflow-hidden p-0 md:grid-cols-2"
          data-reveal
          data-module={m.no}
        >
          <figure class:list={['m-0', index % 2 === 1 ? 'md:order-2' : '']}>
            <img
              class="block h-full w-full object-cover"
              src={`/shots/${m.shot}.png`}
              alt={m.alt}
              width="1920"
              height="1080"
              loading={index < 2 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </figure>
          <div class="flex flex-col justify-center p-7 md:p-9">
            <p class="eyebrow">
              {m.no} · {m.tool}
            </p>
            <h2 class="mt-2 font-display text-[22px] font-semibold">{m.title}</h2>
            <ul class="mt-4 flex flex-col gap-2.5">
              {m.points.map((point) => (
                <li class="flex gap-2.5 text-[13px] leading-6 text-v8-ink-soft">
                  <span
                    class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-v8-accent"
                    aria-hidden="true"
                  />
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</Layout>
