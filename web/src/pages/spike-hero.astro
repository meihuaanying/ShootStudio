---
/**
 * V8/D147 · S1 设计 spike：官网首屏样板（报告见 docs/qa/v8-s1-design-spike.md）
 * 纪律：
 *  - R71 本页所有视觉值只来自 src/styles/tokens.css（CSS 变量），不写硬编码色值/字号/间距；
 *  - R72 明暗双主题 × 1280×800 / 1920×1080 截图由 web/tool/shot.mjs 产出到 docs/screenshots/v8/。
 * 主题切换：URL 追加 ?t=darkroom（默认 paper），保证一次构建覆盖两套主题。
 */
import '../styles/tokens.css';

const theme = import.meta.env.PUBLIC_SPIKE_THEME ?? 'paper';

const kv = [
  { k: 'LIGHT', v: '3 · KEY 01' },
  { k: 'CAMERA', v: '35MM · 1/125 · F2' },
  { k: 'OUTPUT', v: '16:9 · 4K' },
];

const strip = [
  { t: '画面参考', d: '按色调、构图、光比归类；可离线保存' },
  { t: '布光预演', d: '三点布光与机位预设，实时看光比' },
  { t: '动作摆姿', d: '骨架照片 + 12 关节推导，一键注入' },
];

const frames = [
  { label: '3:2 · 横幅', ratio: '3 / 2' },
  { label: '4:5 · 竖幅', ratio: '4 / 5' },
  { label: '16:9 · 视口', ratio: '16 / 9' },
];
---

<!DOCTYPE html>
<html lang="zh-CN" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>S1 设计 spike · 首屏样板</title>
  </head>
  <body>
    <header class="topbar">
      <div class="wrap">
        <div class="brand">
          <span class="seal">正</span>
          <span class="brand-name">正片工坊 <span class="mono muted">SHOOTSTUDIO</span></span>
        </div>
        <nav class="topnav">
          {['画面参考', '布光预演', '动作摆姿', '策划案'].map((item, i) => (
            <a class:list={['topnav-link', { active: i === 0 }]} href="#">{item}</a>
          ))}
          <span class="chip">MIT 开源</span>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <section class="hero">
        <div class="col-7">
          <p class="eyebrow">ISSUE 01 · FW26 · 设计 spike</p>
          <h1 class="display">把每一次布光，<br />先拍成一张底片。</h1>
          <p class="lede">
            本地优先的摄影策划工作台：画面参考 → 布光预演 → 动作摆姿 → 一键成案。
            数据留在本机，模型随包，Windows 与 Android 同一套代码。
          </p>
          <div class="cta-row">
            <a class="btn-primary" href="#">开始新策划</a>
            <a class="btn-ghost" href="#">查看模板库</a>
          </div>
          <dl class="kv">
            {kv.map((row) => (
              <div class="kv-row">
                <dt class="mono">{row.k}</dt>
                <dd class="mono">{row.v}</dd>
              </div>
            ))}
          </dl>
        </div>
        <div class="col-5">
          <figure class="frame frame-45">
            <div class="frame-inner">
              <span class="frame-mark">正</span>
            </div>
            <figcaption class="mono">PLATE 04 · 4:5</figcaption>
          </figure>
        </div>
      </section>

      <section class="strip">
        <div class="col-8">
          <p class="eyebrow">FEATURE · EDITORIAL</p>
          <h2 class="h2">四个模块，一条成案链路</h2>
          <div class="feature-grid">
            {
              strip.map((item, i) => (
                <article class="feature">
                  <span class="mono index">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class="h3">{item.t}</h3>
                  <p class="small">{item.d}</p>
                </article>
              ))
            }
          </div>
        </div>
        <div class="col-4">
          <p class="eyebrow">RECENT</p>
          <ul class="recent">
            <li class="recent-row">
              <span class="mono">06-28</span>
              <span>路径追踪静帧 + A/B 对比</span>
            </li>
            <li class="recent-row">
              <span class="mono">06-21</span>
              <span>端上识别 RTMPose/RTMW3D</span>
            </li>
            <li class="recent-row">
              <span class="mono">06-14</span>
              <span>姿势包 10 类 × 12 张</span>
            </li>
          </ul>
          <div class="swatches">
            <span class="swatch" style="background: var(--accent)" title="accent"></span>
            <span class="swatch" style="background: var(--film)" title="film"></span>
            <span class="swatch" style="background: var(--gold)" title="gold"></span>
            <span class="swatch" style="background: var(--ink)" title="ink"></span>
            <span class="mono small muted">12 TOKENS</span>
          </div>
        </div>
      </section>

      <section class="frames">
        {
          frames.map((f) => (
            <figure class="frame">
              <div class="frame-inner" style="aspect-ratio: {f.ratio}">
                <span class="frame-mark small">{f.label.split(' · ')[1]}</span>
              </div>
              <figcaption class="mono small">{f.label}</figcaption>
            </figure>
          ))
        }
      </section>
    </main>

    <script is:inline>
      // R72 截图与验收：URL ?t=darkroom / ?t=paper 切换主题（单次构建覆盖双主题）。
      (function () {
        var q = new URLSearchParams(location.search).get('t');
        if (q === 'darkroom' || q === 'paper') {
          document.documentElement.setAttribute('data-theme', q);
        }
        document.documentElement.classList.add('spike-ready');
      })();
    </script>
  </body>
</html>

<style>
  /* 本页所有值均引用 tokens.css 变量（R71：令牌是唯一视觉来源） */
  * {
    box-sizing: border-box;
  }
  html,
  body {
    margin: 0;
    padding: 0;
  }
  body {
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: var(--type-body);
    line-height: var(--lh-body);
    transition: background var(--motion-normal) var(--motion-ease),
      color var(--motion-normal) var(--motion-ease);
  }
  .mono {
    font-family: var(--font-mono);
  }
  .muted {
    color: var(--muted);
  }
  .small {
    font-size: var(--type-small);
    line-height: var(--lh-small);
  }
  .wrap {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  /* 顶栏 */
  .topbar {
    border-bottom: 1px solid var(--rule);
    background: var(--bg);
  }
  .topbar .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: calc(var(--sp-6) * 2);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }
  .seal {
    display: grid;
    place-items: center;
    width: calc(var(--sp-5) + 4px);
    height: calc(var(--sp-5) + 4px);
    border-radius: var(--radius-chip);
    background: var(--accent);
    color: var(--surface);
    font-size: var(--type-body);
    font-weight: 600;
  }
  .brand-name {
    font-size: var(--type-h3);
    font-weight: 600;
  }
  .topnav {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }
  .topnav-link {
    color: var(--ink-soft);
    text-decoration: none;
    font-size: var(--type-small);
    transition: color var(--motion-fast) var(--motion-ease);
  }
  .topnav-link:hover,
  .topnav-link.active {
    color: var(--accent);
  }
  .chip {
    padding: calc(var(--sp-1) - 1px) var(--sp-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius-chip);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--type-caption);
    line-height: var(--lh-caption);
  }

  /* 通用排版 */
  .eyebrow {
    margin: 0;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--type-caption);
    line-height: var(--lh-caption);
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  .display {
    margin: var(--sp-3) 0 0;
    font-family: var(--font-display);
    font-size: var(--type-display);
    line-height: var(--lh-display);
    font-weight: 600;
  }
  .h2 {
    margin: var(--sp-2) 0 0;
    font-family: var(--font-display);
    font-size: var(--type-h2);
    line-height: var(--lh-h2);
    font-weight: 600;
  }
  .h3 {
    margin: var(--sp-2) 0 0;
    font-size: var(--type-h3);
    line-height: var(--lh-h3);
    font-weight: 600;
  }
  .lede {
    margin: var(--sp-3) 0 0;
    max-width: 46ch;
    color: var(--ink-soft);
    font-size: var(--type-body);
    line-height: var(--lh-body);
  }

  /* 栅格（12 列 / 列距 24） */
  .hero,
  .strip,
  .frames {
    display: grid;
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    column-gap: var(--gutter);
  }
  .hero {
    padding: var(--sp-8) 0 var(--sp-7);
    align-items: start;
  }
  .strip {
    padding: var(--sp-7) 0;
    border-top: 1px solid var(--rule);
  }
  .col-4 {
    grid-column: span 4;
  }
  .col-5 {
    grid-column: span 5;
  }
  .col-7 {
    grid-column: span 7;
  }
  .col-8 {
    grid-column: span 8;
  }

  /* 按钮 */
  .cta-row {
    display: flex;
    gap: var(--sp-3);
    margin-top: var(--sp-5);
  }
  .btn-primary,
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: calc(var(--sp-5) + var(--sp-3));
    padding: 0 var(--sp-5);
    border-radius: var(--radius-control);
    font-size: var(--type-body);
    text-decoration: none;
    transition: transform var(--motion-fast) var(--motion-ease),
      background var(--motion-fast) var(--motion-ease);
  }
  .btn-primary {
    background: var(--ink);
    color: var(--bg);
  }
  .btn-ghost {
    border: 1px solid var(--rule);
    color: var(--ink-soft);
  }
  .btn-primary:hover {
    transform: translateY(-1px);
  }

  /* KV 读数 */
  .kv {
    display: flex;
    gap: var(--sp-6);
    margin: var(--sp-5) 0 0;
  }
  .kv-row {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }
  .kv dt {
    color: var(--muted);
    font-size: var(--type-caption);
    line-height: var(--lh-caption);
    letter-spacing: 1.5px;
  }
  .kv dd {
    margin: 0;
    font-size: var(--type-small);
    line-height: var(--lh-small);
  }

  /* 图框（衬线首字占位） */
  .frame {
    margin: 0;
  }
  .frame-inner {
    display: grid;
    place-items: center;
    width: 100%;
    background: var(--surface-sunken);
    border: 1px solid var(--rule);
    border-radius: var(--radius-frame);
    box-shadow: var(--shadow-paper);
  }
  .frame-45 .frame-inner {
    height: 420px;
  }
  .frame-mark {
    color: var(--rule);
    font-family: var(--font-display);
    font-size: var(--type-display);
    font-weight: 600;
  }
  .frame-mark.small {
    font-size: var(--type-h3);
  }
  figcaption {
    margin-top: var(--sp-2);
    color: var(--muted);
    letter-spacing: 1.5px;
  }

  /* 功能三联 */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gutter);
    margin-top: var(--sp-4);
  }
  .feature {
    padding: var(--sp-3);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-control);
  }
  .feature .index {
    color: var(--accent);
    font-size: var(--type-caption);
    letter-spacing: 1.5px;
  }
  .feature p {
    margin: var(--sp-1) 0 0;
    color: var(--ink-soft);
  }

  /* 最近更新 + 色板 */
  .recent {
    margin: var(--sp-3) 0 0;
    padding: 0;
    list-style: none;
  }
  .recent-row {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-3);
    padding: var(--sp-2) 0;
    border-bottom: 1px solid var(--rule);
    font-size: var(--type-small);
  }
  .recent-row .mono {
    color: var(--muted);
    letter-spacing: 1.5px;
  }
  .swatches {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin-top: var(--sp-4);
  }
  .swatch {
    width: var(--sp-4);
    height: var(--sp-4);
    border: 1px solid var(--rule);
    border-radius: var(--radius-chip);
  }

  /* 比例样张 */
  .frames {
    padding: var(--sp-7) 0;
    border-top: 1px solid var(--rule);
  }
  .frames .frame {
    grid-column: span 4;
  }
</style>
