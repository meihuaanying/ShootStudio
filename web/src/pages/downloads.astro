---
import Layout from '../layouts/Layout.astro';
const version = import.meta.env.PUBLIC_APP_VERSION?.replace(/^v/, '') || '1.3.0';
---

<Layout title="下载 · 正片工坊 ShootStudio">
  <section class="mx-auto max-w-[1280px] px-6 pb-8 pt-14">
    <p class="eyebrow" data-reveal>下载</p>
    <h1 class="mt-3 font-display text-[28px] font-semibold md:text-[40px]" data-reveal>
      下载中心
    </h1>
    <p class="mt-4 max-w-2xl text-[14px] leading-6 text-v8-ink-soft" data-reveal>
      默认提供国内 CDN 镜像源，不可用时自动回退 GitHub Release 直链；两个源均提供 SHA-256
      校验值。版本号、下载链接与校验值都来自同一个公告文件，可自建站点或走内网。
    </p>
  </section>

  <section class="mx-auto grid max-w-[1280px] gap-4 px-6 md:grid-cols-2" data-reveal>
    <!-- D157 通道约定：8 个 DOM id 由下方 script 写入，改版不得删改这些 id。 -->
    <div class="card flex flex-col gap-3 p-6">
      <h2 class="font-display text-[17px] font-semibold">Windows 安装包</h2>
      <p class="mono text-v8-accent">v<span id="win-ver">{version}</span></p>
      <a
        id="win-mirror"
        href="/downloads"
        class="btn-primary w-full">镜像下载（推荐）</a
      >
      <a
        id="win-github"
        href="https://github.com/shoot-studio/shoot-studio/releases"
        class="btn-ghost w-full">GitHub Release</a
      >
      <p class="mono break-all text-v8-muted">
        SHA-256：<span id="win-sha">发布时由 CI 写入</span>
      </p>
    </div>
    <div class="card flex flex-col gap-3 p-6">
      <h2 class="font-display text-[17px] font-semibold">安卓 APK</h2>
      <p class="mono text-v8-accent">v<span id="and-ver">{version}</span></p>
      <a
        id="and-mirror"
        href="/downloads"
        class="btn-primary w-full">镜像下载（推荐）</a
      >
      <a
        id="and-github"
        href="https://github.com/shoot-studio/shoot-studio/releases"
        class="btn-ghost w-full">GitHub Release</a
      >
      <p class="mono break-all text-v8-muted">
        SHA-256：<span id="and-sha">发布时由 CI 写入</span>
      </p>
    </div>
  </section>

  <section class="mx-auto grid max-w-[1280px] items-start gap-6 px-6 py-14 md:grid-cols-2" data-reveal>
    <div class="card p-6">
      <h2 class="font-display text-[17px] font-semibold">系统要求与安装</h2>
      <ul class="mt-4 flex flex-col gap-2 text-[13px] leading-6 text-v8-ink-soft">
        <li class="flex gap-2.5">
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-v8-accent" aria-hidden="true"
          ></span><span>Windows：Windows 10 22H2 / 11 及以上（x64）。首次运行选择本地目录作为工作区。</span>
        </li>
        <li class="flex gap-2.5">
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-v8-accent" aria-hidden="true"
          ></span><span>Android：Android 8.0（API 26）及以上；3D 预览依赖系统 WebView 组件。</span>
        </li>
        <li class="flex gap-2.5">
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-v8-accent" aria-hidden="true"
          ></span><span>校验：下载后执行 <code class="mono">certutil -hashfile 文件名 SHA256</code> 并与此页校验值比对。</span>
        </li>
        <li class="flex gap-2.5">
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-v8-accent" aria-hidden="true"
          ></span><span>Windows 3D 预览需要 WebView2 Runtime（Win11 与新版 Win10 已内置）；缺失时其余功能不受影响。</span>
        </li>
      </ul>
    </div>
    <figure class="shot">
      <img
        src="/shots/shell-home.png"
        alt="应用首屏：五大入口与最近策划案"
        width="1920"
        height="1080"
        loading="lazy"
        decoding="async"
      />
      <figcaption class="mono mt-2 text-v8-muted">
        应用首屏 · 五大入口与最近策划案
      </figcaption>
    </figure>
  </section>

  <script>
    // D157：announcements.json 通道保持不变（官网与 App 共用同一份公告）。
    fetch('/announcements.json')
      .then((r) => r.json())
      .then((ann) => {
        const win = ann.downloads?.windows;
        const android = ann.downloads?.android;
        if (ann.version) {
          document.getElementById('win-ver').textContent = ann.version;
          document.getElementById('and-ver').textContent = ann.version;
        }
        if (win) {
          document.getElementById('win-mirror').href = win.mirror || win.github;
          document.getElementById('win-github').href = win.github;
          document.getElementById('win-sha').textContent =
            win.sha256 || '发布时由 CI 写入';
        }
        if (android) {
          document.getElementById('and-mirror').href = android.mirror || android.github;
          document.getElementById('and-github').href = android.github;
          document.getElementById('and-sha').textContent =
            android.sha256 || '发布时由 CI 写入';
        }
      })
      .catch(() => {});
  </script>
</Layout>
