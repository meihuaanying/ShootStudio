---
// 官网基础布局：导航 / 页脚 / 全局动效脚本（D12/D13；W1 修复 global.css 引入）。
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
}
const { title = '正片工坊 ShootStudio', description = '画面参考 → 布光预演 → 动作摆姿 → 一键成案：本地优先的免费开源摄影策划工作台（Windows + Android）。' } = Astro.props;
const nav = [
  { href: '/', label: '首页' },
  { href: '/features', label: '功能' },
  { href: '/templates', label: '模板库' },
  { href: '/downloads', label: '下载' },
  { href: '/changelog', label: '更新日志' },
];
const path = Astro.url.pathname;
---
<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-screen">
    <header class="sticky top-0 z-50 border-b border-ss-rule dark:border-ss-rule-dark bg-ss-bg/80 dark:bg-ss-bg-dark/80 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3">
        <a href="/" class="flex items-center gap-2.5">
          <span class="grid h-7 w-7 place-items-center rounded-lg bg-gradient-to-br from-ss-accent to-ss-accent2 text-[13px] font-extrabold text-white">正</span>
          <span class="text-[15px] font-extrabold tracking-tight">正片工坊 <span class="mono text-ss-muted dark:text-ss-muted-dark">SHOOTSTUDIO</span></span>
        </a>
        <nav class="flex min-w-0 items-center justify-end gap-3 overflow-x-auto whitespace-nowrap text-[12.5px] md:gap-5 md:text-[13px]">
          {nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                'transition-colors hover:text-ss-accent',
                path === item.href || (item.href !== '/' && path.startsWith(item.href))
                  ? 'text-ss-accent font-semibold'
                  : 'text-ss-muted dark:text-ss-muted-dark',
              ]}
            >{item.label}</a>
          ))}
          <a href="https://github.com/shoot-studio/shoot-studio" target="_blank" rel="noopener" class="hidden text-ss-muted dark:text-ss-muted-dark transition-colors hover:text-ss-accent md:inline">GitHub ↗</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-20 border-t border-ss-rule dark:border-ss-rule-dark">
      <div class="mx-auto max-w-6xl px-6 py-10 text-[12px] text-ss-muted dark:text-ss-muted-dark">
        <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
          <p>正片工坊 ShootStudio · Flutter 单代码库（Windows + Android）· MIT 开源</p>
          <p>
            模板 / 姿势包 / 布光预设经 CDN 增量下发，无需升级应用 ·
            <a class="text-ss-accent hover:underline" href="/changelog">更新日志</a>
          </p>
        </div>
      </div>
    </footer>

    <script>
      import '../scripts/motion.js';
    </script>
  </body>
</html>
